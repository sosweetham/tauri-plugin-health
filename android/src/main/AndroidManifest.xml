<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect read permissions for all v1 metrics. These merge
         into the consumer app's manifest. Apps using a subset should strip
         unused ones with tools:node="remove" in their own manifest — Google
         Play health policy requires declaring only what you use (see the
         README). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- Package visibility for the Health Connect provider (Android 11+). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>
        <!-- Mandatory: Health Connect's permission sheet links here when the
             user taps the privacy-policy entry (Android 13 and lower). The
             default UI shows overridable string resources
             (tauri_health_rationale_title / tauri_health_rationale_text) and
             an optional button opening the URL from the consumer app's
             app.tauri.health.PRIVACY_POLICY_URL meta-data. -->
        <activity
            android:name="app.tauri.health.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ routes the same flow through VIEW_PERMISSION_USAGE
             with the HEALTH_PERMISSIONS category. -->
        <activity-alias
            android:name="app.tauri.health.ViewPermissionUsageActivity"
            android:targetActivity="app.tauri.health.PermissionsRationaleActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
